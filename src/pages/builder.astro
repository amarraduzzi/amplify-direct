---
import Base from '../layouts/Base.astro';
const accents = [['#05B962', 'Vert'], ['#0A3F7A', 'Bleu'], ['#C2410C', 'Brique'], ['#7A1F3D', 'Bordeaux'], ['#E9B949', 'Safran']];
const themes = [['cafe', 'Café'], ['pizza', 'Pizza'], ['lounge', 'Lounge']];
const toggles = [['order', 'Bouton Commander'], ['reviews', 'Avis Google'], ['hours', 'Horaires']];
---
<Base title="Créer mon site, Amplify Direct" description="Composez le site de votre restaurant et voyez le résultat en direct.">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-[1fr_20rem] md:py-16" id="builder">
    <div class="space-y-9">
      <h1 class="text-5xl md:text-6xl">Composez<br />votre site</h1>
      <label class="block"><span class="font-semibold">Nom du restaurant</span>
        <input id="name" value="Café Dar Nour" class="mt-2 min-h-12 w-full rounded-2xl bg-paper px-4 ring-1 ring-line" /></label>
      <fieldset><legend class="font-semibold">Style</legend>
        <div class="mt-2 flex flex-wrap gap-2">{themes.map(([v, l], i) => <button type="button" data-theme={v} class={`min-h-11 rounded-full px-5 ring-1 ring-line ${i === 0 ? 'chip-on' : 'bg-paper'}`}>{l}</button>)}</div></fieldset>
      <fieldset><legend class="font-semibold">Couleur</legend>
        <div class="mt-2 flex gap-3">{accents.map(([c, l], i) => <button type="button" data-accent={c} aria-label={l} style={`background:${c}`} class={`size-11 rounded-full ring-offset-2 ${i === 0 ? 'ring-2 ring-navy' : ''}`}></button>)}</div></fieldset>
      <fieldset><legend class="font-semibold">Sections</legend>
        <div class="mt-2 space-y-2">{toggles.map(([v, l]) => <label class="flex min-h-11 items-center gap-3"><input type="checkbox" data-sec={v} checked class="size-5 accent-[#05B962]" />{l}</label>)}</div></fieldset>
      <label class="block"><span class="font-semibold">Numéro WhatsApp des commandes</span>
        <input id="wa" inputmode="tel" placeholder="06 00 00 00 00" class="mt-2 min-h-12 w-full rounded-2xl bg-paper px-4 ring-1 ring-line" /></label>
      <div>
        <button type="button" id="publish" class="min-h-12 rounded-full bg-green px-7 font-medium text-navy hover:bg-[#04A859]">Publier mon site</button>
        <p id="msg" class="mt-3 hidden text-muted" role="status">Aperçu seulement pour l’instant : la création du compte et la mise en ligne arrivent à l’étape suivante.</p>
      </div>
    </div>
    <div class="md:sticky md:top-24 md:self-start">
      <div id="pv" class="phone mx-auto flex w-full max-w-[19rem] flex-col text-navy" style="--ac:#05B962;--ac-ink:#001E3E">
        <div class="pv-hero px-5 pb-6 pt-10"><p id="pv-tag" class="text-sm opacity-75"></p><p id="pv-name" class="mt-1 text-3xl font-extrabold leading-none"></p></div>
        <ul id="pv-items" class="flex-1 divide-y divide-line overflow-hidden px-5 text-sm"></ul>
        <div class="space-y-2 p-4 text-center text-xs text-muted">
          <span data-s="order" class="flex min-h-11 items-center justify-center rounded-full pv-hero text-sm font-semibold">Commander sur WhatsApp</span>
          <p data-s="reviews">★★★★★ 5,0 sur Google</p>
          <p data-s="hours">Ouvert tous les jours</p>
        </div>
      </div>
    </div>
  </div>
  <script>
    const THEMES: Record<string, { tag: string; items: [string, string][] }> = {
      cafe: { tag: 'Café · Rabat', items: [['Msemen au miel', '12'], ['Thé à la menthe', '16'], ['Jus d’orange', '14']] },
      pizza: { tag: 'Pizzeria · Rabat', items: [['Pizza Margarita', '36'], ['Pizza Pollo', '48'], ['Pasta Alfredo', '52']] },
      lounge: { tag: 'Lounge · Rabat', items: [['Tartare de thon', '90'], ['Risotto aux crevettes', '110'], ['Mojito maison', '45']] },
    };
    const pv = document.getElementById('pv') as HTMLElement;
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const all = (s: string) => [...document.querySelectorAll<HTMLElement>(s)];
    let theme = 'cafe';
    const draw = () => {
      $('#pv-name').textContent = ($('#name') as HTMLInputElement).value || 'Votre restaurant';
      $('#pv-tag').textContent = THEMES[theme].tag;
      $('#pv-items').innerHTML = THEMES[theme].items.map(([n, p]) => `<li class="flex justify-between py-3.5"><span class="font-medium">${n}</span><span class="text-muted">${p} MAD</span></li>`).join('');
    };
    const ink = (hex: string) => { const [r, g, b] = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16)); return (0.299 * r + 0.587 * g + 0.114 * b) > 150 ? '#001E3E' : '#FFFFFF'; };
    $('#name').addEventListener('input', draw);
    all('[data-theme]').forEach(b => b.addEventListener('click', () => { theme = b.dataset.theme!; all('[data-theme]').forEach(x => { x.classList.toggle('chip-on', x === b); x.classList.toggle('bg-paper', x !== b); }); draw(); }));
    all('[data-accent]').forEach(b => b.addEventListener('click', () => { const c = b.dataset.accent!; pv.style.setProperty('--ac', c); pv.style.setProperty('--ac-ink', ink(c)); all('[data-accent]').forEach(x => x.classList.toggle('ring-2', x === b)); }));
    all('[data-sec]').forEach(i => i.addEventListener('change', () => all(`[data-s="${i.dataset.sec}"]`).forEach(e => e.hidden = !(i as HTMLInputElement).checked)));
    $('#publish').addEventListener('click', () => $('#msg').classList.remove('hidden'));
    draw();
  </script>
</Base>
